# Variables de entorno para el proyecto Memory Game
# Copia este archivo a .env y rellena los valores reales.

# Base de datos (PostgreSQL vía Docker Compose)
DATABASE_URL=postgres://user:password@db:5432/mydatabase

# Upstash Redis (Leaderboard)
# Consigue estos valores en https://console.upstash.com/ de tu base de datos Redis
UPSTASH_REDIS_REST_URL=https://tu-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_de_acceso
